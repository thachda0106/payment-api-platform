# ============================================================================
# Dockerfile.nodejs — Node.js (Fastify + TS) multi-stage build (context: repo root)
# ============================================================================
# Usage:
#   docker build -f docker/Dockerfile.nodejs --build-arg SERVICE_PATH=services/nodejs/notification-service -t payment-api/notification-service:latest .
#   docker compose build notification-service  (handled by docker-compose.yml)
#
# The repo layout is preserved inside the image so the service's
# `file:../../../libs/nodejs` dependency resolves exactly as it does locally.
# ============================================================================

# ─── Stage 1: Build (shared lib + service) ──────────────────────────────────
FROM node:22-alpine AS builder
ARG SERVICE_PATH
WORKDIR /repo

# Build the shared platform lib first
COPY libs/nodejs /repo/libs/nodejs
RUN cd /repo/libs/nodejs && npm install --legacy-peer-deps && npm run build

# Build the service (path preserved so file: dependency resolves)
COPY ${SERVICE_PATH} /repo/${SERVICE_PATH}
RUN cd /repo/${SERVICE_PATH} && npm install --legacy-peer-deps && npm run build

# ─── Stage 2: Runtime ───────────────────────────────────────────────────────
FROM node:22-alpine
ARG SERVICE_PATH
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app

# Copy built service (dist + node_modules + package.json)
COPY --from=builder /repo/${SERVICE_PATH}/dist ./dist
COPY --from=builder /repo/${SERVICE_PATH}/node_modules ./node_modules
COPY --from=builder /repo/${SERVICE_PATH}/package*.json ./
# The linked lib lives under node_modules/@payment-api/platform-libs (symlink → copy target)
COPY --from=builder /repo/libs/nodejs ./libs/nodejs

RUN chown -R app:app /app
USER app

ENV NODE_ENV=production
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
  CMD wget -qO- http://localhost:3001/liveness || exit 1

CMD ["node", "dist/main.js"]
