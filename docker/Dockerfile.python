# ============================================================================
# Dockerfile.python — Python FastAPI multi-stage build (context: repo root)
# ============================================================================
# Usage:
#   docker build -f docker/Dockerfile.python --build-arg SERVICE_PATH=services/python/fraud-service -t payment-api/fraud-service:latest .
#   docker compose build fraud-service  (handled by docker-compose.yml)
# ============================================================================

# ─── Stage 1: Builder — install dependencies + shared lib ──────────────────
FROM python:3.12-slim AS builder
ARG SERVICE_PATH
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*

# Service dependencies
COPY ${SERVICE_PATH}/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Shared platform lib (installed into the same prefix)
COPY libs/python /libs/python
RUN pip install --no-cache-dir --prefix=/install /libs/python

# ─── Stage 2: Runtime ───────────────────────────────────────────────────────
FROM python:3.12-slim
ARG SERVICE_PATH

RUN groupadd --system app && useradd --system --gid app --create-home app

COPY --from=builder /install /usr/local

# Application code
COPY ${SERVICE_PATH} /app
WORKDIR /app
RUN pip install --no-cache-dir -e . 2>/dev/null || true

RUN chown -R app:app /app
USER app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app/src

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/liveness')" || exit 1

CMD ["uvicorn", "fraud_service.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "src"]
