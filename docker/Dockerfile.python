# ============================================================================
# Dockerfile.python — Python FastAPI multi-stage build
# ============================================================================
# Build:  docker build -f docker/Dockerfile.python -t payment-api/{svc}:latest services/python/{svc}
# Run:    docker run -p 8000:8000 payment-api/{svc}:latest
# ============================================================================

# ─── Stage 1: Builder — install dependencies ───────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency files and install to /install prefix
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ─── Stage 2: Runtime ──────────────────────────────────────────────────────
FROM python:3.12-slim

# Create non-root user
RUN groupadd --system app && useradd --system --gid app --create-home app

# Copy installed dependencies from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY . /app
WORKDIR /app

# Install the application package
RUN pip install --no-cache-dir -e . 2>/dev/null || true

# Fix permissions
RUN chown -R app:app /app
USER app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
