{
  "type": "record",
  "name": "PaymentCanceled",
  "namespace": "com.paymentplatform.payments",
  "doc": "Emitted when a created payment is canceled before settlement. BACKWARD compatibility.",
  "fields": [
    { "name": "id", "type": "string" },
    { "name": "type", "type": "string" },
    { "name": "time", "type": "string" },
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "PaymentCanceledData",
        "fields": [
          { "name": "payment_id", "type": "string" },
          { "name": "customer_id", "type": "string" },
          { "name": "merchant_id", "type": "string" },
          { "name": "amount", "type": "long", "doc": "minor units" },
          { "name": "currency", "type": "string" },
          { "name": "reason", "type": "string", "default": "" }
        ]
      }
    },
    {
      "name": "trigger",
      "type": {
        "type": "record",
        "name": "EventTrigger",
        "fields": [
          { "name": "service", "type": "string" },
          { "name": "instance", "type": "string", "default": "" },
          { "name": "request_id", "type": "string", "default": "" },
          { "name": "idempotency_key", "type": "string", "default": "" }
        ]
      }
    }
  ]
}
